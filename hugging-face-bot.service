[Unit]
Description=Hugging Face News Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=owen
WorkingDirectory=/home/owen/Projects/Side-projects/hugging-face-bot
ExecStart=/home/owen/Projects/Side-projects/hugging-face-bot/.venv/bin/python bot.py
Restart=always
RestartSec=10

# Bot loads .env via python-dotenv from WorkingDirectory

[Install]
WantedBy=multi-user.target


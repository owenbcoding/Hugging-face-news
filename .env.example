DISCORD_TOKEN=your_discord_bot_token_here
# Discord text channel ID where news should be posted
CHANNEL_ID=123456789012345678
# Poll interval in minutes (180 = every 3 hours)
POLL_MINUTES=180
# How many articles to post each poll (default: 3, newest first)
MAX_POSTS_PER_RUN=3
# Delay between posts in seconds (default: 5)
POST_DELAY_SECONDS=5


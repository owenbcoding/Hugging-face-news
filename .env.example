DISCORD_TOKEN=your_discord_bot_token_here
# Discord text channel ID where news should be posted
CHANNEL_ID=
# Posts run automatically at 09:00 UTC and 17:00 UTC (same schedule as dev-news-bot)
# How many articles to post per run (default: 3, newest first)
MAX_POSTS_PER_RUN=3
# Delay between posts in seconds (default: 5)
POST_DELAY_SECONDS=5
# Append-only archive of posted links
ARCHIVE_PATH=data/news_archive.jsonl
# Canonical URL dedupe index keyed by sha256(canonical_url)
DEDUPE_INDEX_PATH=data/dedupe_index.json
# Optionally send a plain-text digest after embed posts
POST_TEXT_DIGEST=false

